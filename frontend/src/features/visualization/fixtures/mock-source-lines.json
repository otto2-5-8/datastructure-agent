      "sourceVersion": "mock-binary-search-v1",
      "language": "c",
      "mock": true,
      "title": "闭区间二分查找（展示用，模拟）",
      "lines": [
        { "text": "int binarySearch(const int A[], int n, int target) {" },
        { "text": "  int left = 0, right = n - 1;", "lineId": "init" },
        { "text": "  while (left <= right) {" },
        { "text": "    int mid = left + (right - left) / 2;", "lineId": "probe" },
        { "text": "    if (A[mid] == target) {" },
        { "text": "      return mid;", "lineId": "found" },
        { "text": "    }" },
        { "text": "    if (A[mid] < target) {" },
        { "text": "      left = mid + 1;", "lineId": "update-left" },
        { "text": "    } else {" },
        { "text": "      right = mid - 1;", "lineId": "update-right" },
        { "text": "    }" },
        { "text": "  }" },
        { "text": "  return -1;", "lineId": "not-found" },
        { "text": "}" }
      ]
    }
  ]
